---
import { aboutCopy, pillars } from '../data/about';
import SectionHead from './SectionHead.astro';
---

<section id="about" class="section">
  <div class="wrap">
    <SectionHead eyebrow={aboutCopy.eyebrow}>
      Systems that scale because they're <em>well modelled</em>
    </SectionHead>
    <p class="about-lead" set:html={aboutCopy.lead} />
    <p class="about-languages" set:html={aboutCopy.languages} />
    <div class="pillars">
      {
        pillars.map((pillar) => (
          <article class="pillar">
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
