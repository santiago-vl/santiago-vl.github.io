---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="contact" id="contact">
  <div class="wrap">
    <span class="mono">Contacto</span>
    <p class="contact-big">Hable<em>mos.</em></p>
    <div class="contact-links">
      <button class="contact-mail" type="button" data-copy-email={site.email}>{site.email}</button>
      {
        site.socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            {social.label} ↗
          </a>
        ))
      }
    </div>
    <div class="contact-foot">
      <span class="mono">© {year} {site.name}</span>
      <span class="mono">Hecho en {site.location}</span>
    </div>
  </div>
</footer>
