---
import HobbyCard from './HobbyCard.astro';
import InvestingChart from './InvestingChart.astro';
import Portfolio from './Portfolio.astro';
---

<div class="hobbies-grid">
  <HobbyCard
    variant="hobby-surf"
    meta="Atlantic · Galicia"
    title="Surf"
    description="Cold mornings, long paddles, short rewards. The closest thing I've found to meditation that also burns your shoulders."
  >
    <div slot="bg" class="hobby-bg hobby-bg-surf"></div>
  </HobbyCard>

  <HobbyCard
    variant="hobby-investing"
    meta="Long-term · disciplined"
    title="Investing"
    description="Building a long-term portfolio. Macro · fundamental · technical analysis, systematic rebalancing, and the discipline of not flinching when the screen turns red."
  >
    <div slot="bg" class="hobby-bg hobby-bg-invest">
      <InvestingChart />
    </div>
  </HobbyCard>
</div>

<Portfolio />
