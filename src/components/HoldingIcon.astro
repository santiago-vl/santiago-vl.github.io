---
import type { Holding } from '../data/portfolio';

interface Props {
  holding: Holding;
}

const { holding } = Astro.props;
---

<span class="cv-logo-wrap">
  <img
    class:list={['cv-logo', holding.plate && 'cv-logo-fav']}
    src={holding.icon}
    alt={holding.name}
    loading="lazy"
  />
  <div class="cv-tooltip">
    <span class="cv-tt-name">{holding.name}</span>
    {holding.isin && <span class="cv-tt-isin">{holding.isin}</span>}
  </div>
</span>
