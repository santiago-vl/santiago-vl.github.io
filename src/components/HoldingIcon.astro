---
import type { Holding } from '../data/portfolio';

interface Props {
  holding: Holding;
}

const { holding } = Astro.props;
---

<span class="holding">
  <img class:list={[holding.plate && 'is-plate']} src={holding.icon} alt={holding.name} loading="lazy" />
  <span class="holding-tip">
    <span class="holding-name">{holding.name}</span>
    {holding.isin && <span class="holding-isin">{holding.isin}</span>}
  </span>
</span>
