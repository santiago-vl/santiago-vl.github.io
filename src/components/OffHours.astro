---
import SectionHead from './SectionHead.astro';
import Portfolio from './Portfolio.astro';
---

<section id="off-hours" class="section">
  <div class="wrap">
    <SectionHead eyebrow="Fuera del código">Olas y <em>mercados</em></SectionHead>

    <figure class="surf">
      <img src="/assets/surf.jpg" alt="Dos surfistas con sus tablas en Galicia" loading="lazy" />
      <figcaption>
        <span class="note">Atlántico · agua a 14 °C</span>
        <h3>Surf</h3>
        <p>
          Mañanas frías, remadas largas, premios cortos. Lo más parecido a meditar que conozco, solo
          que te quema los hombros.
        </p>
      </figcaption>
    </figure>

    <Portfolio />
  </div>
</section>
