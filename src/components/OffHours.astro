---
import SectionHead from './SectionHead.astro';
import Portfolio from './Portfolio.astro';
---

<section id="off-hours" class="section">
  <div class="wrap">
    <SectionHead eyebrow="Off the clock">Waves and <em>markets</em></SectionHead>

    <figure class="surf">
      <img src="/assets/surf.jpg" alt="Two surfers with their boards in Galicia" loading="lazy" />
      <figcaption>
        <span class="note">Atlantic · water at 14 °C</span>
        <h3>Surf</h3>
        <p>
          Cold mornings, long paddles, short rewards. The closest thing to meditation I know, except
          it burns your shoulders.
        </p>
      </figcaption>
    </figure>

    <Portfolio />
  </div>
</section>
