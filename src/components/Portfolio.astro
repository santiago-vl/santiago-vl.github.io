---
import { sectors, brands, portfolioCopy } from '../data/portfolio';
import SectorCard from './SectorCard.astro';
---

<div class="hobby-deep-dive">
  <div class="portfolio-block">
    <div class="deep-dive-header">
      <span class="hobbies-eyebrow">{portfolioCopy.eyebrow}</span>
      <h3 class="deep-dive-title">{portfolioCopy.title}</h3>
      <p class="deep-dive-sub">{portfolioCopy.subtitle}</p>
    </div>

    <div class="alloc-bar" aria-label="Portfolio allocation by theme">
      {
        sectors.map((sector) => (
          <span
            class="alloc-seg"
            style={`--w: ${sector.weight}%; --c: ${sector.color};`}
            title={`${sector.name} ${sector.weight}%`}
          >
            <i>{sector.weight}%</i>
          </span>
        ))
      }
    </div>
    <ul class="alloc-legend" aria-label="Portfolio allocation legend">
      {
        sectors.map((sector) => (
          <li style={`--c: ${sector.color};`}>
            <span class="alloc-key" aria-hidden="true" />
            <span>{sector.barLabel}</span>
            <span class="alloc-weight">{sector.weight}%</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="themes-section">
    <div class="sector-grid">
      {sectors.map((sector) => <SectorCard sector={sector} />)}
    </div>

    <div class="logo-carousel" aria-label="Brands in my portfolio">
      <div class="logo-track">
        {brands.map((brand) => <img src={brand.src} alt={brand.alt} class="logo-item" />)}
        {brands.map((brand) => <img src={brand.src} alt="" class="logo-item" aria-hidden="true" />)}
      </div>
    </div>

    <p class="rp-note">{portfolioCopy.note}</p>
  </div>
</div>
