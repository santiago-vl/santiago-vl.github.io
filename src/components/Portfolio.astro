---
import { sectors, brands, portfolioCopy } from '../data/portfolio';
import SectorCard from './SectorCard.astro';

const byWeight = [...sectors].sort((a, b) => b.weight - a.weight);
---

<div class="book">
  <div class="book-head">
    <div>
      <span class="mono">{portfolioCopy.eyebrow}</span>
      <h3>{portfolioCopy.title}</h3>
    </div>
    <p>{portfolioCopy.subtitle}</p>
  </div>

  <div class="alloc" role="img" aria-label="Allocation by sector">
    {
      byWeight.map((sector) => (
        <span
          style={`--c: ${sector.color}; --w: ${sector.weight}`}
          title={`${sector.name} ${sector.weight}%`}
        />
      ))
    }
  </div>

  <div class="sectors">
    {sectors.map((sector) => <SectorCard sector={sector} />)}
  </div>

  <div class="marquee" aria-label="Brands in my portfolio">
    <div class="marquee-track">
      {brands.map((brand) => <img src={brand.src} alt={brand.alt} loading="lazy" />)}
      {brands.map((brand) => <img src={brand.src} alt="" aria-hidden="true" loading="lazy" />)}
    </div>
  </div>

  <span class="mono">{portfolioCopy.note}</span>
</div>
