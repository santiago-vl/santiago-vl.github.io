---
import { statusLabel, type Project } from '../data/projects';

interface Props {
  project: Project;
  letter: string;
}

const { project, letter } = Astro.props;
const host = project.href ? new URL(project.href).host : '';
---

<article class="inset graduated" style={`--c: ${project.color}`}>
  <div class="inset-top">
    <span class="inset-letter">{letter}</span>
    <h3>{project.name}</h3>
    <span class:list={['inset-status mono', project.status === 'live' && 'is-live']}>
      {statusLabel[project.status]}
    </span>
  </div>

  {
    project.media.kind === 'screenshot' && project.href ? (
      <a class="shot" href={project.href} target="_blank" rel="noopener noreferrer">
        <img src={project.media.src} alt={project.media.alt} loading="lazy" />
        <span class="shot-go">{host} ↗</span>
      </a>
    ) : (
      <div class="shot restricted" role="img" aria-label={`${project.name}: proyecto privado`}>
        <div class="restricted-inner">
          <span class="mono">Zona restringida</span>
          <b>{project.name}</b>
          <span class="mono">Acceso privado · en desarrollo</span>
        </div>
      </div>
    )
  }

  <div class="inset-body">
    <p>{project.description}</p>
    <ul class="tags">
      {project.tags.map((tag) => <li class:list={[tag.ai && 'ai']}>{tag.label}</li>)}
    </ul>
  </div>
</article>
