---
import { projects } from '../data/projects';
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';

const letters = 'ABCDEFGH';
---

<section id="projects" class="section">
  <div class="wrap">
    <SectionHead
      eyebrow="Built in my spare time"
      lead="Four products of my own, each with its own identity. All with an LLM at the core doing real work."
    >
      Personal <em>projects</em>
    </SectionHead>
    <div class="insets">
      {projects.map((project, i) => <ProjectCard project={project} letter={letters[i] ?? ''} />)}
    </div>
  </div>
</section>
