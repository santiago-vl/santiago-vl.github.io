---
interface Props {
  num: string;
  text: string;
  /** Anchor id (when the heading itself is the scroll target). */
  id?: string;
  /** Optional right-aligned aside. */
  aside?: string;
  class?: string;
}

const { num, text, id, aside, class: className } = Astro.props;
---

<h2 id={id} class:list={['section-eyebrow', className]}>
  <span class="se-num">{num}</span><span class="se-dash">—</span><span class="se-text">{text}</span>
  {aside && <span class="se-aside">{aside}</span>}
</h2>
