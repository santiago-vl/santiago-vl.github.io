---
import type { Conviction, Sector } from '../data/portfolio';
import HoldingIcon from './HoldingIcon.astro';

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;

const convictionLabel: Record<Conviction, string> = {
  core: 'Core',
  tactical: 'Tactical',
  hedge: 'Hedge',
};
---

<article class:list={['sector', sector.feature && 'is-wide']} style={`--c: ${sector.color}`}>
  <div class="sector-head">
    <b class="sector-pct">{sector.weight}<small>%</small></b>
    <div>
      <h4>{sector.name}</h4>
      <span class:list={['conviction', sector.conviction === 'core' && 'is-core']}>
        {convictionLabel[sector.conviction]}
      </span>
    </div>
  </div>
  <p>{sector.thesis}</p>
  <div class="holdings">
    {sector.holdings.map((holding) => <HoldingIcon holding={holding} />)}
  </div>
</article>
