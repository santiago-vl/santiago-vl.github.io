---
import { site } from '../data/site';
import { navItems } from '../data/navigation';
---

<header class="site-header">
  <div class="wrap">
    <a class="site-mark" href="#top">{site.initials}</a>
    <nav class="site-nav" aria-label="Secciones">
      {navItems.map((item) => <a href={`#${item.target}`}>{item.label}</a>)}
    </nav>
    <div class="site-links">
      <a class="site-link is-primary" href={`mailto:${site.email}`}>Email</a>
      {
        site.socials.map((social) => (
          <a class="site-link" href={social.href} target="_blank" rel="noopener noreferrer">
            {social.label} ↗
          </a>
        ))
      }
    </div>
  </div>
</header>
