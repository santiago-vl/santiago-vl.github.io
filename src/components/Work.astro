---
import { employers, clients } from '../data/experience';
import SectionHead from './SectionHead.astro';
import JobCard from './JobCard.astro';
---

<section id="work" class="section">
  <div class="wrap">
    <SectionHead eyebrow="Trayectoria · 2017 → hoy">Dónde he <em>trabajado</em></SectionHead>
    <div class="work">
      <div class="lane">
        <span class="lane-label mono">Empleador</span>
        <div class="lane-cards">
          {employers.map((job) => <JobCard job={job} />)}
        </div>
      </div>
      <div class="lane">
        <span class="lane-label mono">Cliente · on-site</span>
        <div class="lane-cards">
          {clients.map((job) => <JobCard job={job} client />)}
        </div>
      </div>
    </div>
  </div>
</section>
