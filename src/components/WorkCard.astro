---
import type { Job } from '../data/experience';

interface Props {
  job: Job;
  track: 'employer' | 'client';
}

const { job, track } = Astro.props;

// Grid placement class, e.g. "diverger-logo" -> "wh-diverger".
const placement = `wh-${job.logoClass.replace('-logo', '')}`;
const trackClass = track === 'employer' ? 'work-card-employer' : 'work-card-client';
---

<div class:list={['work-card', trackClass, placement]}>
  <a
    href={job.href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={['timeline-logo', job.logoClass]}
    aria-label={job.company}></a>

  {
    track === 'client' ? (
      <div class="wh-inditex-content">
        <p class="work-role">{job.role}</p>
        <p class="work-company">{job.company}</p>
        <p class="work-duration" data-start-date={job.startDate}>
          {job.duration}
        </p>
        {job.subnote && <p class="work-subnote">{job.subnote}</p>}
      </div>
    ) : (
      <>
        <p class="work-role">{job.role}</p>
        <p class="work-company">{job.company}</p>
        <p class="work-duration" data-start-date={job.startDate}>
          {job.duration}
        </p>
      </>
    )
  }
</div>
