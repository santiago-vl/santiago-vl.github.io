---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Hobbies from '../components/Hobbies.astro';
---

<BaseLayout>
  <Header />
  <Nav />

  <section id="about-me" class="section-wrapper section-white">
    <div class="section-content">
      <About />
    </div>
  </section>

  <section id="work-experience" class="section-wrapper section-dark">
    <div class="section-content">
      <Work />
    </div>
  </section>

  <section id="projects" class="section-wrapper section-white">
    <div class="section-content">
      <Projects />
    </div>
  </section>

  <section id="hobbies" class="section-wrapper section-hero-dark">
    <div class="section-content">
      <Hobbies />
    </div>
  </section>
</BaseLayout>
